    "email:test": "node scripts/send-test-email.mjs",
    "s3:cors": "node scripts/s3-cors.mjs",
    "infra:synth": "npm run --prefix infra synth",
    "infra:diff": "npm run --prefix infra diff",
    "infra:deploy": "npm run --prefix infra deploy",
