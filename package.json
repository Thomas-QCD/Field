{
  "name": "field",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:restart": "node scripts/dev-stop.mjs && node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "cap:sync": "npm run build && npx cap sync",
    "cap:live": "node scripts/cap-live.mjs",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "apk:serve": "node scripts/apk-serve.mjs",
    "adb:unload": "node scripts/adb-unload.mjs",
    "adb:virtual": "node scripts/adb-target.mjs virtual",
    "adb:physical": "node scripts/adb-target.mjs physical",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "pdf:docket": "node scripts/generate-delivery-docket.mjs",
    "db:schema": "node scripts/apply-schema.mjs",
    "db:import-contacts": "node scripts/import-contacts.mjs",
    "db:import-addresses": "node scripts/import-addresses.mjs",
    "db:import-users": "node scripts/import-users.mjs",
    "db:import-wodely-tasks": "node scripts/import-wodely-tasks.mjs",
    "s3:cors": "node scripts/s3-cors.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@azure/msal-browser": "^5.17.1",
    "@azure/msal-react": "^5.5.3",
    "@capacitor-community/camera-preview": "^7.0.5",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/preferences": "^7.0.4",
    "@mantine/core": "9.4.1",
    "@mantine/hooks": "9.4.1",
    "ag-grid-community": "^36.0.1",
    "ag-grid-react": "^36.0.1",
    "jose": "^6.2.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "pdfjs-dist": "^6.1.200",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.19",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
