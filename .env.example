# Copy to .env and fill in. Never commit .env.
# The Node API loads this file on startup (Vite also loads it).

# Amazon RDS (field-dev, us-west-1) — cloud-backed local development
# Host: field-dev.c9saiusmgamc.us-west-1.rds.amazonaws.com
# Port: 5432
# Database: field
# User: field_admin
# Password: fetch from Secrets Manager (do not commit):
#   aws secretsmanager get-secret-value \
#     --region us-west-1 \
#     --secret-id "arn:aws:secretsmanager:us-west-1:730335210534:secret:rds!db-01f1889d-8922-4311-88c5-3c3f4ffb540b-7lxFSw" \
#     --query SecretString --output text
# Secret JSON key: password
#
# URL-encode special characters in the password (# → %23, < → %3C, ? → %3F, etc).
# Or set PGPASSWORD=... instead and leave the password out of DATABASE_URL.
#
# DATABASE_URL=postgresql://field_admin:<password>@field-dev.c9saiusmgamc.us-west-1.rds.amazonaws.com:5432/field

DATABASE_URL=

# S3 attachments (field-dev-attachments, us-west-1) — private bucket; presigned PUT/GET
# Credentials: default AWS chain (e.g. `aws login` / SSO profile). Do not commit keys.
# CORS covers localhost, Android emulator (10.0.2.2), Capacitor origins, and current LAN IP.
# When your LAN IP changes (physical device live reload): npm run s3:cors
# After staging is deployed, s3:cors also picks up CloudFront from SSM /field/staging/url
AWS_REGION=us-west-1
S3_BUCKET=field-dev-attachments

# --- Android release signing (sideload) ---
# One-time: FIELD_KEYSTORE_PASSWORD='…' npm run android:keystore
# Then: npm run apk:staging
# Keystore + android/keystore.properties are gitignored — back them up.

# Outbound email — SES in us-west-1 (domain identity qcdlv.net). Credentials: default AWS chain.
# EMAIL_PROVIDER=console logs instead of sending (no AWS call).
# Test: npm run email:test  (default To: thomas@qcdlv.com)
EMAIL_PROVIDER=ses
EMAIL_FROM=noreply@qcdlv.net
EMAIL_CONFIGURATION_SET=notify_on_error

# --- Web auth: Microsoft Entra ID (MSAL) — web only; mobile uses QR (not Entra) ---
# Leave unset for local stub login (user picker). When set, web requires Sign in with Microsoft.
# Register a SPA in Entra: redirect URI http://localhost:5173 (type: Single-page application).
# See docs/sdd.md §7.1 and the SSO plan "Your actions after implementation".
# VITE_* are read by the browser; AZURE_* by the API (must match the same app registration).
#
# VITE_AZURE_CLIENT_ID=
# VITE_AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# Optional: custom API audience if you expose an API scope (otherwise ID tokens use client ID as aud)
# AZURE_API_AUDIENCE=
